#include <Arduino.h>
#include <Wire.h>
#include <LiquidCrystal.h>
#include <ESP32SPISlave.h>

//*****************************************************/
// DEFINICIONES I2C
//*****************************************************/
#define I2C_DEV_ADDR 0x32
#define SDA_PIN 21
#define SCL_PIN 22
#define POT1 14

//*****************************************************/
// PINES LCD
//*****************************************************/
#define EN 2
#define RS 15
#define d0 0
#define d1 4
#define d2 5
#define d3 18
#define d4 19
#define d5 27
#define d6 12
#define d7 23

LiquidCrystal lcd (RS, EN, d0, d1, d2, d3, d4, d5, d6, d7);

//*****************************************************/
// PINES LED
//*****************************************************/
#define LED_ROJO 26
#define LED_VERDE 33
#define LED_AMARILLO 25

//*****************************************************/
// PROTOTIPOS
//*****************************************************/
void onReceive(int len);
void onRequest();

//*****************************************************/
// VARIABLES I2C
//*****************************************************/
volatile bool solicitudLectura = false;
volatile uint16_t sensor = 0;

//*****************************************************/
// VARIABLES LCD
//*****************************************************/
int lecturaPot = 0;
int valorPot = 0;
int milivoltios = 0;
float voltajePot = 0;
char ultimoLED = ' ';

//*****************************************************/
// COMUNICACION SPI
//*****************************************************/
#define QUEUE_SIZE 1

ESP32SPISlave slave;
bool spiPendiente = false;

uint8_t datosRecibidos[5] = {0, 0, 0, 0, 0};
uint8_t respuesta[5] = {0, 0, 0, 0, 0};
uint8_t estado = 0;

//*****************************************************/
// CONTROL DEL TIEMPO
//*****************************************************/
uint8_t ledElegido = 0;
uint8_t ledEncendido = 0;
uint32_t tiempoLED = 0;
uint32_t tiempoRestante = 0;
uint32_t ultimaRevision = 0;
uint32_t ultimaLCD = 0;

//*****************************************************/
// CONFIGURACION
//*****************************************************/
void setup()
{
    //==================================================
    // CONFIGURAR LEDs
    //==================================================
    pinMode(LED_ROJO, OUTPUT);
    pinMode(LED_AMARILLO, OUTPUT);
    pinMode(LED_VERDE, OUTPUT);

    digitalWrite(LED_ROJO, LOW);
    digitalWrite(LED_AMARILLO, LOW);
    digitalWrite(LED_VERDE, LOW);

    //==================================================
    // CONFIGURAR POTENCIOMETRO
    //==================================================
    pinMode(POT1, INPUT);

    analogReadResolution(12);
    analogSetPinAttenuation(POT1, ADC_11db);

    //==================================================
    // COMUNICACION SERIAL
    //==================================================
    Serial.begin(115200);

    //==================================================
    // I2C COMO ESCLAVO
    //==================================================
    Wire.onReceive(onReceive);
    Wire.onRequest(onRequest);

    if (Wire.begin((uint8_t)I2C_DEV_ADDR, SDA_PIN, SCL_PIN, 100000UL)) { Serial.println("I2C esclavo listo");} 
    else {
    Serial.println("ERROR: no se pudo iniciar I2C");
}
    Serial.println("Direccion I2C: 0x32");
    Serial.println("SDA: GPIO21");
    Serial.println("SCL: GPIO22");

    //==================================================
    // LCD
    //==================================================
    lcd.begin(16, 2);
    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("Pot1:");

    lcd.setCursor(7, 0);
    lcd.print("ADC:");

    lcd.setCursor(12, 0);
    lcd.print("LED:");

    //==================================================
    // SPI
    //==================================================
    slave.setDataMode(SPI_MODE0);
    slave.setQueueSize(QUEUE_SIZE);

    // Orden:
    // bus, SCK, MISO, MOSI, CS
    slave.begin(HSPI, 35, 32, 34, 39);

    respuesta[0] = estado;
    if (slave.queue(respuesta, datosRecibidos, 5)) {spiPendiente = slave.trigger();}

    ultimaLCD = millis() - 300;
}

//*****************************************************/
// LOOP PRINCIPAL
//*****************************************************/
void loop()
{
    //==================================================
    // PARTE I2C
    //==================================================
    if (solicitudLectura)
    {
        solicitudLectura = false;
        // Leer potenciometro
        uint16_t lecturaPotI2C = analogRead(POT1);

        // Guardar lectura
        sensor = lecturaPotI2C;

        // Convertir ADC a 0-255
        uint8_t valorPotI2C = map(lecturaPotI2C, 0, 4095, 0, 255);

        // Convertir a milivoltios
        uint16_t milivoltiosI2C = map(lecturaPotI2C, 0, 4095, 0, 3300);

        // Convertir a voltios
        float voltajeI2C = milivoltiosI2C / 1000.0;

        // Mostrar por monitor serial
        Serial.println();
        Serial.println("===== I2C =====");

        Serial.print("ADC: ");
        Serial.println(lecturaPotI2C);
        
        Serial.print("Voltaje: ");
        Serial.println(voltajeI2C,3);

        // Preparar respuesta I2C
        uint8_t respuestaI2C[2] =
        {
            (uint8_t)(lecturaPotI2C >> 8),
            (uint8_t)(lecturaPotI2C & 0xFF)
        };

#if CONFIG_IDF_TARGET_ESP32

        Wire.slaveWrite(
            respuestaI2C,
            sizeof(respuestaI2C)
        );

#endif
    }

    //==================================================
    // REVISAR TRANSACCION SPI
    //==================================================
    if (
        slave.hasTransactionsCompletedAndAllResultsReady(QUEUE_SIZE)
    )
    {
        size_t cantidadRecibida = slave.numBytesReceived();
        spiPendiente = false;

        if (cantidadRecibida == 5 && datosRecibidos[0] != 0) { Serial.printf("COMANDO SPI: bytes=%u, LED=%u\n",(unsigned)cantidadRecibida,(unsigned)datosRecibidos[0]);
}
        if (cantidadRecibida == 5)
        {
            // Un cero significa consulta de estado
            if (datosRecibidos[0] != 0)
            {
                // Solo aceptar una nueva orden
                // si el LED anterior termino
                if (ledEncendido == 0)
                {
                    ledElegido =datosRecibidos[0];

                    if (
                        ledElegido >= 1 &&
                        ledElegido <= 3
                    )
                    {
                        // Reconstruir tiempo de 32 bits
                        tiempoLED =
                            (uint32_t)datosRecibidos[1] + (uint32_t)datosRecibidos[2] * 256UL + (uint32_t)datosRecibidos[3] * 65536UL + (uint32_t)datosRecibidos[4] * 16777216UL;

                        // Apagar todos los LEDs
                        digitalWrite(LED_ROJO, LOW);
                        digitalWrite(LED_AMARILLO,LOW);
                        digitalWrite(LED_VERDE,LOW);

                        // Guardar ultimo LED
                        if (ledElegido == 1)
                        {
                            ultimoLED = 'R';
                        }
                        else if (ledElegido == 2)
                        {
                            ultimoLED = 'A';
                        }
                        else if (ledElegido == 3)
                        {
                            ultimoLED = 'V';
                        }

                        // Si el tiempo es cero
                        if (tiempoLED == 0)
                        {
                            estado = 2;
                        }
                        else
                        {
                            // Encender LED seleccionado
                            if (ledElegido == 1)
                            {
                                digitalWrite(LED_ROJO, HIGH);
                            }
                            else if (ledElegido == 2)
                            {
                                digitalWrite(LED_AMARILLO, HIGH);
                            }
                            else if (ledElegido == 3)
                            {
                                digitalWrite(LED_VERDE, HIGH);
                            }

                            tiempoRestante = tiempoLED;
                            ultimaRevision = millis();
                            ledEncendido = 1;
                            estado = 1;
                        }

                        // Mostrar ultimo LED
                        lcd.setCursor(12, 1);
                        lcd.print(ultimoLED);
                    }
                    else
                    {
                        estado = 3;
                    }
                }
            }
        }
        else
        {
            if (ledEncendido == 0)
            {
                estado = 3;
            }
        }
    }

    //==================================================
    // CONTAR TIEMPO DEL LED
    //==================================================
    if (ledEncendido == 1)
    {
        uint32_t ahora = millis();
        uint32_t transcurrido = ahora - ultimaRevision;

        ultimaRevision = ahora;
        if (transcurrido >= tiempoRestante)
        {
            digitalWrite(LED_ROJO, LOW);
            digitalWrite(LED_AMARILLO, LOW);
            digitalWrite(LED_VERDE, LOW);

            tiempoRestante = 0;
            ledEncendido = 0;
            estado = 2;
        }
        else
        {
            tiempoRestante = tiempoRestante - transcurrido;
        }
    }

    //==================================================
    // PREPARAR SIGUIENTE INTERCAMBIO SPI
    //==================================================
   if (!spiPendiente &&slave.hasTransactionsCompletedAndAllResultsHandled())
{
    respuesta[0] = estado;

    if (slave.queue(respuesta, datosRecibidos, 5)) {spiPendiente = slave.trigger();}
}

    //==================================================
    // ACTUALIZAR LCD
    //==================================================
    if ( (uint32_t)(millis() - ultimaLCD) >= 300)
    {
        ultimaLCD = millis();

        // Leer potenciometro
        lecturaPot = analogRead(POT1);

        // ADC de 12 bits
        valorPot =map(lecturaPot, 0, 4095, 0, 255);

        // Convertir a milivoltios
        milivoltios = map(lecturaPot, 0, 4095, 0, 3300);

        // Convertir a voltios
        voltajePot =milivoltios / 1000.0;

        //==============================================
        // VOLTAJE
        //==============================================
        lcd.setCursor(0, 1);
        lcd.print("      ");
        lcd.setCursor(0, 1);
        lcd.print(voltajePot, 2);
        lcd.print("V");

        //==============================================
        // ADC
        //==============================================
        lcd.setCursor(7, 1);
        lcd.print("     ");
        lcd.setCursor(7, 1);
        lcd.print(lecturaPot);

        //==============================================
        // ULTIMO LED
        //==============================================
        lcd.setCursor(12, 1);
        lcd.print(ultimoLED);
    }

    delay(1);
}

//*****************************************************/
// FUNCION I2C: SOLICITUD
//*****************************************************/
void onRequest()
{
}

//*****************************************************/
// FUNCION I2C: RECEPCION
//*****************************************************/
void onReceive(int len){
    Serial.print("I2C recibio: ");
    Serial.println(len);

    while (Wire.available())
    {
        char comando =
            (char)Wire.read();

        Serial.print("Comando recibido: ");
        Serial.println(comando);

        if (comando == 'S')
        {
            solicitudLectura = true;
        }
    }
}
