/* ============================================================
   INTERRUPCION UART
   Parte 1 + Parte 2
   ============================================================ */

void HAL_UART_RxCpltCallback(
    UART_HandleTypeDef *huart
)
{
    if (huart->Instance != USART2)
    {
        return;
    }


    /* ========================================================
       MENU PRINCIPAL
       ======================================================== */

    if (estado == 0)
    {
        if (datoUART == '1')
        {
            cantidad = 0;

            comandoLargo = 0;

            estado = 1;

            opcion1 = 1;
        }

        else if (datoUART == '2')
        {
            opcion2 = 1;
        }

        else if (
            datoUART != '\r' &&
            datoUART != '\n'
        )
        {
            opcionInvalida = 1;
        }
    }


    /* ========================================================
       RECIBIR COMANDO LED,TIEMPO
       ======================================================== */

    else if (estado == 1)
    {
        if (
            datoUART == '\r' ||
            datoUART == '\n'
        )
        {
            if (cantidad > 0)
            {
                estado = 2;
            }

            else if (comandoLargo == 1)
            {
                estado = 2;
            }
        }

        else
        {
            if (
                cantidad < sizeof(comando)
            )
            {
                comando[cantidad] =
                    datoUART;

                cantidad++;

                /*
                 * Guardar momento del ultimo
                 * caracter recibido.
                 */
                ultimoDatoUART =
                    HAL_GetTick();
            }

            else
            {
                comandoLargo = 1;
            }
        }
    }


    /*
     * Continuar recibiendo caracteres.
     */
    HAL_UART_Receive_IT(&huart2, &datoUART,1);
}


