/* ============================================================
   PARTE 3 - COMUNICACION I2C
   ============================================================ */

static void SolicitarLecturaPotenciometro(void)
{
    uint8_t comandoI2C = 'S';

    uint8_t datosRecibidos[2] = {0};
    uint16_t valorPotenciometro;
    char mensaje[100];

    MostrarTexto("\r\nSolicitando medicion al ESP32...\r\n");

    /* Envia comando '2' al ESP32 */
    if (HAL_I2C_Master_Transmit(&hi2c1, deviceAddress, &comandoI2C, 1, HAL_MAX_DELAY) != HAL_OK)
    {
        uint32_t errorI2C = HAL_I2C_GetError(&hi2c1);

        char mensajeError[80];

        snprintf(mensajeError, sizeof(mensajeError), "Error I2C: %lu\r\n", errorI2C);

        MostrarTexto(mensajeError);

        return;
    }


     /* Espera a que el ESP32 lea el ADC */
    HAL_Delay(100);

    /* Recibe los dos bytes de la medicion */
    if (HAL_I2C_Master_Receive(&hi2c1, deviceAddress, datosRecibidos, 2, HAL_MAX_DELAY) != HAL_OK)
    {
        MostrarTexto("Error: no se pudo recibir la medicion.\r\n");
        return;
    }

    /*
     * Une byte alto y byte bajo.
     */
    valorPotenciometro = ((uint16_t)datosRecibidos[0] << 8) | (uint16_t)datosRecibidos[1];

    /*
     * Validar rango del ADC de 12 bits.
     */
    if (valorPotenciometro > 4095U)
    {
        MostrarTexto("Error: medicion recibida fuera de rango.\r\n");
        return;
    }

    /*
     * Mostrar el valor en bits.
     */
    snprintf(mensaje, sizeof(mensaje), "Medicion sensor: %u\r\n", (unsigned int)valorPotenciometro);

    MostrarTexto(mensaje);
}


/* ============================================================
   PARTE 5 - LEER TIEMPO DEL COMANDO
   ============================================================ */

uint32_t LeerTiempo(const char *texto)
{
    /*
     * Buscar la primera coma.
     */
    const char *cursor = texto;

    while (*cursor != '\0' && *cursor != ',')
    {
        cursor++;
    }

    /*
     * Si no hay coma, comando invalido.
     */
    if (*cursor != ',')
    {
        return 0U;
    }

    /*
     * Avanzar despues de la coma.
     */
    cursor++;

    /*
     * Debe existir un numero despues de la coma.
     */
    if (*cursor == '\0')
    {
        return 0U;
    }

    uint32_t duracionMs = 0U;

    while (*cursor != '\0')
    {
        /*
         * Solo aceptar numeros.
         */
        if (*cursor < '0' || *cursor > '9')
        {
            return 0U;
        }

        duracionMs = duracionMs * 10U + (uint32_t)(*cursor - '0');

        /*
         * Limitar el tiempo a 60000 ms.
         */
        if (duracionMs > 60000U)
        {
            return 0U;
        }

        cursor++;
    }

    return duracionMs;
}


/* ============================================================
   PARTE 5 - CONFIGURAR SENAL CUADRADA
   ============================================================ */

void ConfigurarSenal(uint32_t tiempoMs)
{
    if (tiempoMs == 0U || tiempoMs > 60000U)
    {
        return;
    }

    /*
     * Detener PWM antes de cambiar sus parametros.
     */
    if (HAL_TIM_PWM_Stop(&htim2, TIM_CHANNEL_1) != HAL_OK)
    {
        Error_Handler();
    }

    __HAL_TIM_SET_AUTORELOAD(&htim2, (200U * tiempoMs) - 1U);

    /*
     * Duty cycle del 50 %.
     */
    __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_1, 100U * tiempoMs);

    /*
     * Aplicar los nuevos valores.
     */
    if (HAL_TIM_GenerateEvent(&htim2, TIM_EVENTSOURCE_UPDATE) != HAL_OK)
    {
        Error_Handler();
    }

    /*
     * Reiniciar contador.
     */
    __HAL_TIM_SET_COUNTER(&htim2, 0U);

    __HAL_TIM_CLEAR_FLAG(&htim2, TIM_FLAG_UPDATE);

    /*
     * Iniciar nuevamente el PWM.
     */
    if (HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_1) != HAL_OK)
    {
        Error_Handler();
    }
}


