/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART2_UART_Init();
  MX_SPI2_Init();
  MX_I2C1_Init();
  MX_TIM2_Init();
  /* USER CODE BEGIN 2 */

  /*
   * CS del ESP32 en estado inactivo.
   */
  HAL_GPIO_WritePin(CS_ESP32_GPIO_Port, CS_ESP32_Pin, GPIO_PIN_SET);

  /*
   * Iniciar recepcion UART mediante interrupcion.
   */
  if (HAL_UART_Receive_IT(&huart2, &datoUART, 1) != HAL_OK)
  {
      Error_Handler();
  }

  /*
   * Mostrar UNICAMENTE el menu principal.
   */
  HAL_UART_Transmit(&huart2, menu, sizeof(menu) - 1, 100);

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */

  while (1)
  {

    /* ========================================================
       OPCION 1 - CONTROL SPI
       ======================================================== */

    if (opcion1 == 1)
    {
        opcion1 = 0;

        HAL_UART_Transmit(&huart2, msjSPI, sizeof(msjSPI) - 1, 100);

        HAL_UART_Transmit(&huart2, submenuSPI, sizeof(submenuSPI) - 1, 100);
    }


    /* ========================================================
       OPCION 2 - SENSOR I2C
       ======================================================== */

    if (opcion2 == 1)
    {
        opcion2 = 0;

        HAL_UART_Transmit(&huart2, msjI2C, sizeof(msjI2C) - 1, 100);

        SolicitarLecturaPotenciometro();

        /*
         * Regresar al mismo menu principal.
         */
        HAL_UART_Transmit(&huart2, menu, sizeof(menu) - 1, 100);
    }


    /* ========================================================
       OPCION INVALIDA
       ======================================================== */

    if (opcionInvalida == 1)
    {
        opcionInvalida = 0;

        HAL_UART_Transmit(&huart2, msjError, sizeof(msjError) - 1, 100);

        HAL_UART_Transmit(&huart2, menu, sizeof(menu) - 1, 100);
    }


    /* ========================================================
       VALIDAR COMANDO LED,TIEMPO
       ======================================================== */

    if (estado == 1 && cantidad > 0)
    {
        /*
         * Si pasan 100 ms sin recibir otro caracter,
         * se considera terminado el comando.
         */
        if ((uint32_t)(HAL_GetTick() - ultimoDatoUART) >= 100)
        {
            estado = 2;
        }
    }


    /* ========================================================
       PROCESAR COMANDO
       ======================================================== */

    if (estado == 2)
    {
        uint8_t valido = 1;
        uint8_t led = 0;

        tiempoLED = 0;

        /*
         * El comando mas corto valido seria: 1,0
         */
        if (comandoLargo == 1)
        {
            valido = 0;
        }
        else if (cantidad < 3)
        {
            valido = 0;
        }
        else
        {

            /* -----------------------------------------------
               Verificar LED
               ----------------------------------------------- */

            if (comando[0] < '1')
            {
                valido = 0;
            }
            else if (comando[0] > '3')
            {
                valido = 0;
            }


            /* -----------------------------------------------
               Verificar coma
               ----------------------------------------------- */

            if (comando[1] != ',')
            {
                valido = 0;
            }

            led = comando[0] - '0';


            /* -----------------------------------------------
               Convertir tiempo de texto a numero
               ----------------------------------------------- */

            for (uint8_t i = 2; i < cantidad && valido == 1;i++)
            {
                if (comando[i] >= '0' && comando[i] <= '9')
                {
                    uint8_t digito =
                        comando[i] - '0';


                    if (tiempoLED > 429496729UL)
                    {
                        valido = 0;
                    }
                    else if (tiempoLED == 429496729UL && digito > 5)
                    {
                        valido = 0;
                    }
                    else
                    {
                        tiempoLED = tiempoLED * 10U + digito;
                    }
                }
                else
                {
                    valido = 0;
                }
            }
        }


        /* ====================================================
           COMANDO INVALIDO
           ==================================================== */

        if (valido == 0)
        {
            HAL_UART_Transmit(&huart2, msjComandoError, sizeof(msjComandoError) - 1, 100);

            HAL_UART_Transmit(&huart2, submenuSPI, sizeof(submenuSPI) - 1, 100);

            cantidad = 0;
            comandoLargo = 0;

            estado = 1;
        }


        /* ====================================================
           COMANDO VALIDO
           ==================================================== */

        else
        {

            /* -----------------------------------------------
               Preparar los cinco bytes para SPI
               ----------------------------------------------- */

            datosEnviar[0] = led;

            datosEnviar[1] = tiempoLED % 256UL;

            datosEnviar[2] = (tiempoLED / 256UL) % 256UL;

            datosEnviar[3] = (tiempoLED / 65536UL) % 256UL;

            datosEnviar[4] = (tiempoLED / 16777216UL) % 256UL;


            /* -----------------------------------------------
               Enviar comando por SPI
               ----------------------------------------------- */

            HAL_GPIO_WritePin(CS_ESP32_GPIO_Port, CS_ESP32_Pin, GPIO_PIN_RESET);

            HAL_StatusTypeDef resultadoSPI = HAL_SPI_TransmitReceive(&hspi2, datosEnviar, datosRecibir, 5, 100);

            HAL_GPIO_WritePin(CS_ESP32_GPIO_Port, CS_ESP32_Pin, GPIO_PIN_SET);


            if (resultadoSPI == HAL_OK)
            {

                /* -------------------------------------------
                   PARTE 5
                   Configurar la señal con EL MISMO TIEMPO
                   ------------------------------------------- */

                ConfigurarSenal(tiempoLED);


                /* -------------------------------------------
                   Limpiar datos enviados
                   ------------------------------------------- */

                for (uint8_t i = 0; i < 5; i++)
                {
                    datosEnviar[i] = 0;
                }


                ultimaConsulta = HAL_GetTick();

                fallosRespuesta = 0;

                estado = 3;


                HAL_UART_Transmit(&huart2, msjEnviado, sizeof(msjEnviado) - 1, 100);
            }
            else
            {
                HAL_UART_Transmit(&huart2, menu, sizeof(menu) - 1, 100);

                estado = 0;
            }
        }
    }


    /* ========================================================
       ESPERAR A QUE TERMINE EL ESP32
       ======================================================== */

    if (estado == 3)
    {
        if (
            (uint32_t)(HAL_GetTick() - ultimaConsulta) >= 50)
        {
            ultimaConsulta = HAL_GetTick();


            /* -----------------------------------------------
               Limpiar datos recibidos
               ----------------------------------------------- */

            for (uint8_t i = 0; i < 5; i++)
            {
                datosRecibir[i] = 0;
            }


            /* -----------------------------------------------
               Consultar ESP32 por SPI
               ----------------------------------------------- */

            HAL_GPIO_WritePin(CS_ESP32_GPIO_Port, CS_ESP32_Pin, GPIO_PIN_RESET);

            HAL_StatusTypeDef resultadoSPI = HAL_SPI_TransmitReceive(&hspi2, datosEnviar, datosRecibir, 5, 100);

            HAL_GPIO_WritePin(CS_ESP32_GPIO_Port, CS_ESP32_Pin, GPIO_PIN_SET);


            /* -----------------------------------------------
               ESP32 indica que termino
               ----------------------------------------------- */

            if (resultadoSPI == HAL_OK && datosRecibir[0] == 2)
            {
                HAL_UART_Transmit(&huart2, menu, sizeof(menu) - 1, 100);

                estado = 0;
            }


            /* -----------------------------------------------
               ESP32 indica que LED sigue encendido
               ----------------------------------------------- */

            else if (resultadoSPI == HAL_OK && datosRecibir[0] == 1)
            {
                fallosRespuesta = 0;
            }


            /* -----------------------------------------------
               Respuesta invalida
               ----------------------------------------------- */

            else
            {
                if (resultadoSPI == HAL_OK && datosRecibir[0] == 3)
                {
                    fallosRespuesta = 100;
                }
                else
                {
                    fallosRespuesta++;
                }


                /*
                 * Regresar al menu si no hay respuesta valida.
                 */
                if (fallosRespuesta >= 100)
                {
                    HAL_UART_Transmit(
                        &huart2,
                        menu,
                        sizeof(menu) - 1,
                        100
                    );

                    estado = 0;
                }
            }
        }
    }

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

